# copy this file to .env and fill in the values. never commit .env.

# llm: free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODEL=gemini-3.5-flash

# who you are, used in the prompts
AUTHOR_NAME=Aditya Mhaskar
AUTHOR_ROLE=AI/ML engineer at deboistech
AUDIENCE=people in my Discord server

# used for announcement dates. examples: UTC, Asia/Kolkata, America/New_York
TIMEZONE=UTC

# discord: channel settings > integrations > webhooks > new webhook > copy webhook url
# treat this url like a password. anyone who has it can post to your channel.
DISCORD_WEBHOOK_URL=

# true = show the post but do NOT send it. change to false only when you are ready.
DRY_RUN=false
